# PostgreSQL connection string (local Postgres, Neon, or Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ridemate?schema=public"

# Secret key for signing HttpOnly JWT auth cookies (change in production!)
JWT_SECRET="ridemate-dev-super-secret-jwt-key-change-in-prod-32chars"

# Comma-separated allowlist of verified college email domains
ALLOWED_COLLEGE_DOMAINS="rvce.edu.in,college.edu.in"
