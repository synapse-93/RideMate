# Transaction pooler (port 6543) — used by the Next.js app on Vercel
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler / Direct (port 5432) — used by Prisma CLI for db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="replace-with-a-random-32-character-secret-key"
ALLOWED_COLLEGE_DOMAINS="rvce.edu.in,college.edu.in"